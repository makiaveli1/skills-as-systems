{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitecraft.local/schemas/learning-candidate.schema.json",
  "title": "SITECRAFT Learning Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "learning_id",
    "source_project",
    "status",
    "user_verdict",
    "evidence",
    "proposed_lesson",
    "scope",
    "counterexample_risks",
    "contrast_evidence",
    "external_evidence",
    "promotion_target",
    "source_preserved"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "sitecraft-learning-candidate"},
    "learning_id": {"type": "string", "minLength": 1},
    "source_project": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "contrasted", "promoted", "rejected"]},
    "user_verdict": {"enum": ["not_recorded", "positive", "mixed", "negative", "approved_for_promotion"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proposed_lesson": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "counterexample_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contrast_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "external_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "promotion_target": {"type": ["string", "null"]},
    "source_preserved": {"const": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
