  "workflows": [
    {
      "id": "foundry-safe-change",
      "terms": ["implement a feature", "change this software", "repair this system", "refactor safely", "full FOUNDRY pass", "make a substantial code change"],
      "stages": [
        {
          "id": "understand-contract",
          "label": "Map the system and establish the change contract",
          "required_references": ["references/routing.md", "references/understanding-compact.md", "references/codebase-understanding.md", "references/change-compact.md"],
          "artifact_schema": "schemas/change-contract.schema.json",
          "completion_checks": [
            {"pointer": "/status", "allowed": ["ready", "in_progress"]},
            {"pointer": "/authority/permissions_carried_by_contract", "allowed": [false]}
          ],
          "fill_reference_hints": true,
          "max_references": 7
        },
        {
          "id": "implement-bounded",
          "label": "Implement the smallest coherent intervention",
          "required_references": ["references/change-discipline.md", "references/testing-and-evidence.md"],
          "artifact_schema": "schemas/change-contract.schema.json",
          "completion_checks": [
            {"pointer": "/status", "allowed": ["implemented_unverified", "verified"]}
          ],
          "fill_reference_hints": true,
          "max_references": 7
        },
        {
          "id": "verify-challenge",
          "label": "Verify reality and challenge the result",
          "required_references": ["references/verification-compact.md", "references/testing-and-evidence.md", "references/failure-tests.md", "references/evaluation-rubric.md"],
          "artifact_schema": "schemas/verification-receipt.schema.json",
          "completion_checks": [
            {"pointer": "/state/evidence_freshness", "allowed": ["current"]},
            {"pointer": "/verdict", "allowed": ["passed", "passed_with_limits"]}
          ],
          "fill_reference_hints": true,
          "max_references": 8
        },
        {
          "id": "close-continue",
          "label": "Inspect exact state and close or continue",
          "required_references": ["references/verification-compact.md", "references/collaboration-and-continuity.md"],
          "artifact_schema": "schemas/verification-receipt.schema.json",
          "completion_checks": [
            {"pointer": "/state/evidence_freshness", "allowed": ["current"]},
            {"pointer": "/verdict", "allowed": ["passed", "passed_with_limits"]}
          ],
          "fill_reference_hints": false,
          "max_references": 4
        }
      ]
    },
    {
      "id": "foundry-debug-repair",
      "terms": ["debug difficult failure", "find root cause", "repair intermittent failure", "diagnose environment versus code", "fix failing integration"],
      "stages": [
        {
          "id": "reproduce-narrow",
          "label": "Reproduce, collect evidence, and narrow hypotheses",
          "required_references": ["references/debugging-and-repair.md", "references/understanding-compact.md"],
          "artifact_schema": "schemas/change-contract.schema.json",
          "completion_checks": [
            {"pointer": "/baseline/reproduction_status", "allowed": ["reproduced", "partially_reproduced", "not_reproduced"]},
            {"pointer": "/status", "allowed": ["ready", "in_progress", "blocked"]}
          ],
          "fill_reference_hints": true,
          "max_references": 6
        },
        {
          "id": "repair-cause",
          "label": "Repair the causal owner and add regression protection",
          "required_references": ["references/debugging-and-repair.md", "references/change-compact.md", "references/testing-and-evidence.md"],
          "artifact_schema": "schemas/change-contract.schema.json",
          "completion_checks": [
            {"pointer": "/status", "allowed": ["implemented_unverified", "verified"]}
          ],
          "fill_reference_hints": true,
          "max_references": 7
        },
        {
          "id": "replay-regress-widen",
          "label": "Replay the failure, regress the cause, and widen verification",
          "required_references": ["references/testing-and-evidence.md", "references/verification-compact.md", "references/failure-tests.md"],
          "artifact_schema": "schemas/verification-receipt.schema.json",
          "completion_checks": [
            {"pointer": "/state/evidence_freshness", "allowed": ["current"]},
            {"pointer": "/verdict", "allowed": ["passed", "passed_with_limits"]}
          ],
          "fill_reference_hints": true,
          "max_references": 7
        }
      ]
    }
