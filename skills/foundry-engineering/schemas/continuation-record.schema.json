{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.engineering/schemas/continuation-record.schema.json",
  "title": "FOUNDRY Continuation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "continuation_id",
    "project_ref",
    "objective",
    "status",
    "state_ref",
    "changed_surfaces",
    "established_findings",
    "verification_refs",
    "unresolved",
    "dependencies",
    "ownership",
    "invariants",
    "next_eligible_work",
    "exact_references",
    "safety",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "foundry-continuation-record" },
    "continuation_id": { "$ref": "#/$defs/id" },
    "project_ref": { "$ref": "#/$defs/nonempty" },
    "objective": { "$ref": "#/$defs/nonempty" },
    "status": { "enum": ["ready", "attention", "blocked", "running", "complete"] },
    "state_ref": { "$ref": "#/$defs/nonempty" },
    "system_map_ref": { "type": "string" },
    "change_contract_ref": { "type": "string" },
    "changed_surfaces": { "$ref": "#/$defs/string_list" },
    "established_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "statement", "status", "evidence_refs"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/id" },
          "statement": { "$ref": "#/$defs/nonempty" },
          "status": { "enum": ["KNOWN", "INFERRED", "UNKNOWN", "NEEDS_VERIFICATION"] },
          "evidence_refs": { "$ref": "#/$defs/string_list" }
        }
      }
    },
    "verification_refs": { "$ref": "#/$defs/string_list" },
    "unresolved": { "$ref": "#/$defs/string_list" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "status", "blocks"],
        "properties": {
          "dependency_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["ready", "waiting", "blocked", "complete", "unknown"] },
          "blocks": { "$ref": "#/$defs/string_list" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_owner", "write_surfaces", "coordination_state"],
      "properties": {
        "current_owner": { "$ref": "#/$defs/nonempty" },
        "write_surfaces": { "$ref": "#/$defs/string_list" },
        "coordination_state": { "$ref": "#/$defs/nonempty" }
      }
    },
    "invariants": { "$ref": "#/$defs/string_list" },
    "next_eligible_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "action", "eligibility"],
        "properties": {
          "work_id": { "$ref": "#/$defs/id" },
          "action": { "$ref": "#/$defs/nonempty" },
          "eligibility": { "enum": ["ready", "requires_dependency", "requires_verification", "requires_authority"] },
          "dependency_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }
      },
      "minItems": 1
    },
    "exact_references": { "$ref": "#/$defs/string_list" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_hidden_reasoning", "contains_transcript", "contains_secrets", "permissions_carried_over", "receiving_worker_must_refresh_state", "receiving_worker_must_rediscover_capabilities"],
      "properties": {
        "contains_hidden_reasoning": { "const": false },
        "contains_transcript": { "const": false },
        "contains_secrets": { "const": false },
        "permissions_carried_over": { "const": false },
        "receiving_worker_must_refresh_state": { "const": true },
        "receiving_worker_must_rediscover_capabilities": { "const": true }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "string_list": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
